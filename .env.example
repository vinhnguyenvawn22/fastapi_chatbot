# =========================
# GEMINI CONFIG
# =========================
# Không ghi API key thật vào file này.
# Khi chạy thật, hãy copy file này thành .env rồi điền key thật.
GEMINI_API_KEY=your_gemini_api_key_here
# Neu co nhieu key, co the dung mot trong cac cach sau:
# GEMINI_API_KEYS=key_1,key_2,key_3
# GEMINI_API_KEY_1=key_1
# GEMINI_API_KEY_2=key_2
# Cac dong GEMINI_API_KEY lap lai trong .env that cung duoc he thong doc va xoay vong.

# Model Gemini sử dụng cho chatbot
GEMINI_MODEL=gemini-2.5-flash
DOCUMENTS_DIR=uploads/Tổng hợp văn bản AI
DOCUMENT_INDEX_CACHE_ENABLED=true
DOCUMENT_INDEX_CACHE_FILE=storage/document_index/index.json
BUSINESS_DOCUMENTS_DIR=documents/nghiep_vu
BUSINESS_SEARCH_TOP_K=5
BUSINESS_INDEX_CACHE_ENABLED=true
BUSINESS_INDEX_CACHE_FILE=storage/business_knowledge_index/index.json
SEARCH_TOP_K=5
BM25_TOP_K=12
ANN_TOP_K=12
RRF_CANDIDATE_TOP_K=20
RRF_K=60
BM25_K1=1.5
BM25_B=0.75
BM25_METADATA_BOOST=2.0
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_VARIANTS=3
QUERY_EXPANSION_MAX_WORDS=6
QUERY_EXPANSION_CACHE_TTL_SECONDS=1800
QUERY_EXPANSION_CACHE_MAX_ITEMS=256
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CROSS_ENCODER_TOP_N=10
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_CACHE_TTL_SECONDS=1800
CROSS_ENCODER_CACHE_MAX_ITEMS=2048
CROSS_ENCODER_LEXICAL_FAST_PATH=0.8
PRELOAD_RAG_COMPONENTS=false
PRELOAD_EMBEDDING_MODEL=false
PRELOAD_CROSS_ENCODER=false
MAX_CONTEXT_CHUNKS=3
MAX_CONTEXT_CHARS=12000
ES_INDEX=uneti_docs_catalog
MIN_SEARCH_SCORE=4
SEARCH_TOP_K=5
RRF_CANDIDATE_TOP_K=30
BM25_TOP_K=20
BM25_MIN_SCORE=0
BM25_K1=1.5
BM25_B=0.75
BM25_METADATA_BOOST=2.0
ANN_TOP_K=20
RRF_K=60
SHORT_QUERY_MIN_SEARCH_SCORE=10
MIN_VECTOR_CONFIDENCE=0.45
SHORT_QUERY_MIN_VECTOR_CONFIDENCE=0.55
MAX_CONTEXT_DOCS=3
RETRIEVAL_CACHE_SIZE=128
KEYWORD_CONFIDENT_SCORE=40
RERANK_SCORE_GAP_RATIO=0.25
AMBIGUOUS_QUERY_KEYWORD_COUNT=4
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MODEL=gemini-2.5-flash
QUERY_EXPANSION_MAX_VARIANTS=2
QUERY_EXPANSION_MAX_WORDS=6
HYDE_ENABLED=true
HYDE_MODEL=gemini-2.5-flash
HYDE_MAX_WORDS=100
HYDE_ANN_TOP_K=20
HYDE_MIN_TOPIC_CONFIDENCE=0.65
HYDE_MIN_RERANK_SCORE=0.0
PROBE_TOP_K=6
PROBE_EVIDENCE_TOP_K=3
PROBE_BM25_MIN_SCORE=1.5
PROBE_VECTOR_MIN_SCORE=0.42
PROBE_RRF_MIN_SCORE=0.015
PROBE_RRF_SCORE_GAP=0.001
PROBE_MIN_TITLE_OVERLAP=1
PROBE_MIN_EVIDENCE_SIGNALS=2
GROUNDED_HYDE_ANN_TOP_K=20
GROUNDED_HYDE_MAX_EVIDENCE_CHARS=3600
AMBIGUITY_CLARIFY_THRESHOLD=0.40
AMBIGUITY_CACHE_TTL_SECONDS=900
AMBIGUITY_CACHE_MAX_ITEMS=128
HYDE_CACHE_TTL_SECONDS=900
HYDE_CACHE_MAX_ITEMS=128
CROSS_ENCODER_ENABLED=true
CROSS_ENCODER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CROSS_ENCODER_TOP_N=20
CROSS_ENCODER_MAX_LENGTH=512
CROSS_ENCODER_FINAL_TOP_K=5
CROSS_ENCODER_MIN_SCORE=-100
UNETI_WEBSITE_DOMAIN=uneti.edu.vn
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
DISCOVERY_PROJECT_NUMBER=your_google_cloud_project_number
DISCOVERY_LOCATION=global
DISCOVERY_COLLECTION_ID=default_collection
DISCOVERY_ENGINE_ID=your_discovery_engine_id
DISCOVERY_SERVING_CONFIG_ID=default_search
WEBSITE_SEARCH_TOP_K=10
WEBSITE_RERANK_TOP_K=2
WEBSITE_MIN_SOURCE_SCORE=50
WEBSITE_FETCH_TIMEOUT=15
WEBSITE_FETCH_MAX_BYTES=20971520
WEBSITE_EXTRACT_MAX_CHARS=12000
